APP_NAME=JagaSewa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jagasewa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

# JagaSewa Security & Retention Config
BLACKLIST_SECRET=
DOC_RETENTION_CLOSED_DAYS=7
DOC_RETENTION_CANCELLED_DAYS=3
DOC_RETENTION_FALLBACK_DAYS=90
DOCUMENT_RETENTION_DAYS=7
SIGNED_URL_TTL_MINUTES=60

# Database Backup Config
DB_BACKUP_DISK=s3
DB_BACKUP_PASSWORD=
DB_BACKUP_RETENTION_DAYS=30

# Error Monitoring
SENTRY_DSN=
MONITOR_WEBHOOK_URL=
MONITOR_ENABLED=true

# QRIS Engine Microservice (Golang)
QRIS_ENGINE_URL=http://127.0.0.1:8081
QRIS_ENGINE_SECRET=jagasewa-super-secret-key-2026
QRIS_ENGINE_ENABLED=false

VITE_APP_NAME="${APP_NAME}"

